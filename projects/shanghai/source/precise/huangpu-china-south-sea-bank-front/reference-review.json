  "periods": [
    {
      "when": "1917-08",
      "evidence": "马海洋行给里斯公司设计的初始图，五层。"
    },
    {
      "when": "1919-12-15",
      "evidence": "《The Shanghai Times》报道该办公楼已动工，当时汉口路7号。"
    },
    {
      "when": "1921",
      "evidence": "建成后由中南银行使用。证据把设计委托与银行使用分别记录。"
    },
    {
      "when": "20世纪20至30年代",
      "evidence": "早期改建图在屋面局部添L形第六层；1930年代航拍亦可见。"
    },
    {
      "when": "1997",
      "evidence": "加建至七层，五至七层窗墙重做。单开间门厅改为三开间，门前原四柱变八柱。"
    },
    {
      "when": "2021–2023",
      "evidence": "修缮后照片作为材料、窗饰与门廊的可见状态。"
    }
  ],
  "scope": "南侧汉口路中段底层四对光面门柱、三扇门、承托饰带，和二至四层三开间四根贯通多立克柱。保留两端凸翼、上部1997改造的楼层、内部及其它立面。",
