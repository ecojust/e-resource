  "external_map_footprint": "footprint-review.json",
  "identity": "市房屋管理局表2F011以该地块哈尔滨路侧地址2号登记；1994年沿街保护牌及现行OSM地块登记为吴淞路560号，吴淞路与武进路街角旧楼仍存。",
  "public_exterior_scope": "正面凹弧四扇道门、两层相接的敞廊、两端砖翼、吴淞路公共沿街转角与红砖白石瞭望塔。后二层、东部长翼、另一座钢构、用地内附房及后景现代楼不纳入本次拍照建模。",
  "estimated": "平面按公开的楼体轮廓定位；高度、弧线、窗洞、塔厅细分和屋面坡面按公开照片比例。仅手工几何与材质，图片不嵌入资产。",
  "photos_embedded": false
}
