  "levels": [
    {
      "level": 1,
      "gao04": "正面管状小铁栏在灰色栏板顶，十道窄真孔，后方两扇各有独立洞头；门窗下半部受前栏和晾晒遮挡。",
      "masa25": "右半深框玻璃封在前端，西段可见白色防护格延向邻窗。覆盖后的水泥栏原状仅由2013读出。"
    },
    {
      "level": 2,
      "gao04": "左右宽前柱围十条狭长竖孔，板下沿绿漆滴水。后左较宽带亮钢窗、右侧窄扇分开，后壁仍可见砖。",
      "masa25": "依晾竿、低绿缘和槽板复认；衣物未建。"
    },
    {
      "level": 3,
      "gao04": "栏板左半浅色填实，右侧五条狭孔。上沿出画，上半窗的2013状态保留未知。",
      "masa25": "左半前凸银灰框约三竖格，上方薄暗色边；右半可见敞廊板底及后墙。"
    },
    {
      "level": 4,
      "gao04": "未入画。",
      "masa25": "单站可见实栏额、上部轻型金属横栏、左侧浅色窗框，上部檐沿浅色。右后部玻璃反射和悬挂杂物遮住细分，模型只示主分格。"
    }
  ],
  "exclusions": "邻照片26和25左方单元不纳入。未复制玻璃反射、衣物、空调、深处室内、卫星天线或住户信息。",
