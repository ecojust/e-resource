  "restoration_sequence": {
    "school": "1850年徐汇公学创办。",
    "historic_building": "施工单位技术报告区分1917-01-08奠基与1918-06-20落成，保护设计单位以1918为建造年代。",
    "roof_replacement": "承包方记载80年代初改造、90年代初因漏雨拆除原屋面。校史概述同记90年代改为普通屋面。",
    "restoration": "交大保护设计2009年至2010年；2010-11-06实照已具两折灰色屋面和多种形状老虎窗。",
    "later_record": "2012工程获奖报道与2023年正面细照同见南面中轴和石饰。"
  },
