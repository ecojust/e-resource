  "chronology": [
    "高亦寒的黄浦区第三次文物普查资料摘录将102号列为1914年建、福井房一设计。94号另一篇为1912年。",
    "1947年照片已见三层连续窗带、顶部单独圆鼓和下方居中券门。",
    "实物颜色取2015年1月2日实照。2015年5月及2016年5月报道过沿街外墙喷涂和处理，后时段的表面颜色待核。"
  ],
  "photograph_geometry_matches": [
    "底层同为方切面上的单列高圆券门",
    "同一组变曲率的三条窗轴；中层窗为拱顶、四周石框、窗下圆章",
    "楼层腰线水平绕塔，鼓体在主檐上另起，顶部有连续金属栏杆"
  ],
