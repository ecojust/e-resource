  "source_history": [
    {
      "stage": "初步配对",
      "observation": "双院形态与市、区历史资料锁定714。715位于相隔4.66米的窄条，且来源是独立Zenodo数据，初时保留待查。"
    },
    {
      "stage": "三期航片和斜俯照片补证",
      "observation": "2022年图层可辨中轴突出低顶；2024年图层可辨同处低顶和沿前缘成列的柱影，2026年仍见同一突出屋面和台阶。低廊长度及中轴与715相合。区旅游咨询中心俯照将该低顶直接连接到旧主楼，2014街照可数七券。推定715为主楼前廊和台阶的低层范围。715源体24.3米为城市外推高度，不能沿用作廊高。",
      "district_archive_image_sha256": "d14d66b1212406d691ec74cc9ae92ce83d0f3ab3714dff0d0e19934732415f9a"
    }
  ],
  "courtyard_source": "主楼714有两个真实内院，两个内院不设地面阻挡。其余校园楼栋单独保留。",
