  "public_street_photo": {
    "zh": {
      "url": "https://zh.wikipedia.org/wiki/%E6%AD%A3%E5%B9%BF%E5%92%8C%E5%A4%A7%E7%8F%AD%E4%BD%8F%E5%AE%85",
      "status": 200,
