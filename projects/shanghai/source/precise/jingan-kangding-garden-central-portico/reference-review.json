  "working_register": {
    "id": "sh-historic-b4-051",
    "building": "张氏花园住宅",
    "date": "1923年"
  },
  "chronology": "上海静安据《静安文博钩沉》记1923年开建、1925年竣工。",
  "ownership": [
    "上海静安整理的《静安文博钩沉》称为颜料商曹氏兄弟所建，称曹公馆、曹家花园。",
    "2022年小分队街区图文、工作名录称张氏或张发文。市表原始名称为花园住宅，产权人有异说。",
    "《海上记忆：康定路上，故事从徐园讲起》称三幢为苏家翰1923年设计、早期兼作办公和住宅，后为颜料商赵聘侯、赵国亭住所。该说与张、曹两说并列。"
  ],
  "exteriors": [
    {
      "credit": "上海静安整理，信息来源《静安文博钩沉》，2020年3月转载。原摄年未详。",
      "page": "https://m.thepaper.cn/baijiahao_6449450",
      "photo": {
        "source": "https://m.thepaper.cn/baijiahao_6449450",
        "key": "ornament2020",
        "i": 0,
        "url": "https://imagepphcloud.thepaper.cn/pph/image/56/405/390.jpg",
        "caption": "上海老底子 老上海的路名与今天的路名往往大相径庭。例如，万航渡路原来叫极司菲尔路、华山路原来叫海格路、北京西路原来叫爱文义路……随着时代的变迁，旧有的路名已渐渐被新一代人所淡忘。但对于那些曾经经历过那段历史的人来",
        "sha256": "e5aa8188800a6e68ebb99de3b186066bb678dd765b922c559d3f3b1e18eeedcb",
        "bytes": 49491,
