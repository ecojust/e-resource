    "chronology": [
      "1925–1934, Hazzard firm (2022 district/architectural history).",
      "1977 reordered as Jing An Hotel. 1992 two levels added, nine levels in district account. The 2025 report calls the building ten levels and about 38 m. No as-built survey here.",
      "Renovation started 2022, first guest in March 2025, reporting and in-use June 2025. Accounts describe two or three years; source dates take precedence over a reconciled duration."
    ],
    "before": {
      "commons": "https://commons.wikimedia.org/w/api.php?action=query&titles=File%3AHaig+Apartment%2C+Shanghai.jpg&prop=imageinfo&iiprop=url%7Cextmetadata%7Cmetadata%7Csize&iiurlwidth=910&format=json",
      "view": "2014-07-20, oblique view of the short end, pre-renovation; only use to distinguish the sides.",
      "jiefang5": "Explicit caption ‘修缮前的静安宾馆’. Tall curved hotel behind and west/east side towers explain side context."
    },
    "after": {
      "jiefang6": "Explicit caption ‘修缮后的海格公寓’. Signed HAIG COURT portal, wavy stone gable, urns, recessed fanlight, dark double doors.",
      "news254": "June 2025 lawn elevation with two raised triangular-headed shallow bays, four balcony stacks and arched axial portal. Trees obscure some lower bays.",
      "rental22": "Later property dusk photograph supports the same stacks, portal, upper raised bays and center roof fenestration. The skyline in this photograph has no towers and was not used for location or height.",
      "secondary_reprint_exception": "Interior/exterior file numbering of the design article reprint does not reliably match captions. Viewed files 0017/0018/0019 show a different clock-tower property. Excluded as visual witnesses."
    },
    "public_works_evidence": {
      "date": "2025-06-06",
      "credit": "上海市历保中心、上海市建筑装饰工程集团有限公司",
      "article_url": "http://www.shjsjtdw.cn/node2/n59/u1ai15520.html",
      "article_sha256": "76b89aa586fcf1beef2e5b30d02d4529d762c88637adc95f1b9a4aa120c68ddd",
      "observed": {
        "0": "Repaired south face from the courtyard, foreground side trees but entire central ground level and east triple-colonnade legible; nearby tower visible behind.",
        "1": "Early construction archive image. The article does not supply the exposure year.",
        "2": "March 1948 printed period photograph with a distinguishable roof of its era and the longstanding garden entrance.",
        "3": "Garden center upper detail: paired shallow segmental arches, projecting bow-shaped iron rails and shell consoles, paired central sash windows, upper oval medallion and rail.",
        "13": "Post-repair northern service side; retain it separately as original-source context.",
        "14": "Dark restoration sash casing and material contrast at lower floor.",
        "15": "Forged window grille.",
        "16": "End bay ground loggia: three shaped openings over two full freestanding Corinthian shafts, jamb responds, dark setting and metal rails.",
        "17": "Scrolled eaves consoles and red semicylindrical tiles.",
        "18": "Terrace parapet.",
        "19": "Raised red-tiled roofs, top enclosure and set-back white terrace parapet."
      },
      "reported_height_m": 38,
      "reported_terrace_floor": "9F",
      "period_note": "The building article gives a broad 1924–1949 period. District historian 1925–1934; 1948 dated photo directly proves the original in place."
    }
  },
