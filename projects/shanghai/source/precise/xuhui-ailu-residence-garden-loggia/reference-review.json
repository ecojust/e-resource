  "garden_orientation": {
    "outward_bearing_deg": 182.49064802466538,
    "evidence": [
      "2015年甲楼照片：大宽券和上层栏杆在临绿篱的长面，窄券及落水管右转沿铺装路。",
      "2021和2024影像：3522南侧草木区、东侧铺面通道、东翼屋面南出和西侧较低的附翼位置吻合。"
    ],
    "camera_gps_available": false
  },
  "limits": [
    "影像服务的版本发布日期不等于该瓦片的拍摄日期。",
    "1927年婚事传述和OSM录入的1930年诸说分列，现存甲楼的确切竣工时间待考。",
    "屋面仅绘有图证的南侧部分和两个烟囱，北部、邻屋和乙楼外观均保留。"
  ],
