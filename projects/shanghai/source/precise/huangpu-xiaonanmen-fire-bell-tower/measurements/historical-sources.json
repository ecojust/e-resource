{
  "site": "中华路581号，小南门警钟楼",
  "observations": [
    {
      "period": "1907、1909–1910",
      "claim": "1907年救火联合会成立。市文旅等近现代资料将警钟楼系于1909年。民国七年（1918）《上海县续志》卷二「救火会」记宣统二年（1910）落成，原注另记六个月工竣；邱力立记施工跨1909至1910年。",
      "sources": [
        "sh-observer24",
        "haishang",
        "2019-confirmed",
        "municipal-tourism",
        "shanghai-gazetteer-1918-vol2-fire"
      ]
    },
    {
      "period": "1911-11-03",
      "claim": "约14时发出上海光复起义信号。九响停顿后十三响之说来自回顾性记述及消防干事讲述。",
      "sources": [
        "thepaper16",
        "xinmin22"
      ]
    },
    {
      "period": "1909–1911",
      "claim": "图册显示横条上室、小方窗、细栏、旗杆与中央笼梯；两张印本同源，须镜像校方向。",
      "sources": [
        2414354,
        1835431,
        "knyazeva-corrected"
      ]
    },
    {
      "period": "1927-03-21",
      "claim": "南市第三次工人武装起义信号。随后南市有电话，钟的日常报警功能退出，确切年份未定位。",
      "sources": [
        "archive-sm-fire",
        "xinmin22"
      ]
    },
    {
      "period": "1937，另图仅标1937–1949",
      "claim": "屋面有柱端及较实的栏杆，平整上室墙上有方形明暗窗口；未读出带指针、时刻数字的钟盘。",
      "sources": [
        809311,
        930474
      ]
    },
    {
      "period": "2016–2024",
      "claim": "四角收分、中央钢制螺旋梯。两个可辨面上室为横向分格窗，照片未显示读时钟盘。2017作者进入室内，未见原铜钟；2024进保护围挡核实塔仍存。",
      "sources": [
        "thepaper16",
        "fire2017",
        "sh-observer24",
        "municipal-tourism"
      ]
    },
    {
      "period": "战后具体年份未定",
      "claim": "所核时期照片的标年跨1945，方孔不能鉴为有针刻度盘。现阶段不能确定钟盘的安装、拆除年份、数量或位置。",
      "sources": [
        930474,
        "fire2017"
      ]
    }
  ],
