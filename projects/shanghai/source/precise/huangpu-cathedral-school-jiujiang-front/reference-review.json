  "sequence": [
    {
      "stage": "1928",
      "finding": "创设为圣三一堂附属英童学校，现楼中部四层、翼部三层，砖混。"
    },
    {
      "stage": "1937",
      "finding": "同仁医院原址受占，医疗单位暂迁入校楼。"
    },
    {
      "stage": "1941–1945",
      "finding": "市房管局载占用阶段。"
    },
    {
      "stage": "1945以后",
      "finding": "建筑收回后外租予百乐饭店及扬子电气公司，刊中地图有该店中文名及后方教堂。饭店时期图是平面，不能证明相机时代立面所有装饰皆相同。"
    },
    {
      "stage": "1953–2005",
      "finding": "由房管部门管理，曾作区政府等办公。"
    },
    {
      "stage": "2005后",
      "finding": "教会机构使用。"
    },
    {
      "stage": "2013-12-19 14:56:03",
      "finding": "Commons原图修前已见中央尖券和两层贯通窗套、双山墙，局部装饰未清理，不能以现照片铜牌追溯百乐饭店时期。"
    },
    {
      "stage": "2018修缮，2020报道",
      "finding": "整修清水泰山砖、斩假石窗套、钢窗、铸铁水斗和宗教花饰。修后正片可判两铜色长牌、双层尖券、回进暗门及上亮，未根据像素猜小字。"
    }
  ],
