  "names_by_source": {
    "municipal_publish": "慈淑大楼／东海商都，南京东路353号。",
    "municipal_gazetteer_2009": "大陆商场大楼（东海大楼），文内旧门牌327号。大陆银行向哈同洋行租入用地，庄俊设计，公记、申兴泰、褚伦记分期营建。该文记1931年动工，1933年建成。",
    "modern_osm": "慈淑大楼／353广场（Mosaic Mall）；OSM起始日期1932。",
    "working_register": "1932年。楼号与建成年份差异分列出处。"
  },
  "architecture": {
    "historical_layout": "《上海名建筑志》点名北南京路、南九江路、东山东路、西又新街。书中称主楼6层后增1层，南京路中央8层，山东路转角连塔亭9层，原底层以十字通道联系三面街路。",
    "photographed_scope": "南京路步行街与山东中路东北转角。2014、2024外景支持折角旗塔、局部层层收进的塔亭、双窗竖带、折线纹窗下墙、外挑水平腰带、低层商铺及临南京路相接的一段立面。",
    "unresolved": "现代深处的过街通道、南端出口、完整九江路侧和改建后的内部不能从这组照片辨认。当前OSM本体内未见可独立确认该十字通道的公共中心线。"
  },
