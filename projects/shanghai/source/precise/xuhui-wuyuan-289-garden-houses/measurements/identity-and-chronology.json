  "chronology": [
    {
      "record": "2018年2月6日拍摄的上海市优秀历史建筑铭牌。",
      "reading": "联立式住宅。公和洋行设计，1933年竣工。砖木结构。带有都铎式风格特征。",
      "photograph": "gao-02"
    },
    {
      "record": "Dronnikoff建筑师相册",
      "reading": "Maisonettes on Route Maresca built by Palmer & Turner, Architects. 1935. East Elevation / The Whole Block.",
      "photograph": "museum-old"
    },
    {
      "record": "历史研究者对建筑师档案的说明",
      "reading": "Vladimir Dronnikoff and Ilarion Tomashevsky for Palmer and Turner; finished in February 1935.",
      "source_key": "rulj"
    },
    {
      "record": "上海房管名城保护文章",
      "reading": "建于1930年，原为外侨公寓。",
      "source_key": "gov"
    }
  ],
  "identity_and_limits": [
    "北栋门外能同时读到1号与2号。南栋另两站可辨3号和4号。",
    "1935年整组相册没有清晰单户号。两座房子共用的设计细节在资料里按类型登记。",
    "2017年Antigng题名照从五原路向内拍入口铁门，门后的住宅仅见屋顶边缘。",
    "Gao文章发布日期为2013-09-21；门牌01和08原片摄于2013-09-14，市级铭牌02原片摄于2018-02-06。"
  ],
