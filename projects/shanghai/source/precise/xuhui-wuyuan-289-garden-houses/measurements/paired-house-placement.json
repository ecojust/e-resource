  "unit_1_entrance": {
    "side": "靠五原路的北宅东向弄堂面，1号牌见拱门右，2号在外楼梯旁。",
    "east_face_midpoint_wgs84": [
      121.437495947,
      31.213466703
    ],
    "midpoint_uncertainty_m": 6.5,
    "method": "底模东墙两端之间的中点可用于布置宿主；门洞实际中心的绝对点位不足以收紧至米内。",
    "unit_2_end": "2号牌在同一幢门面向房看去的左端，即照片外楼梯上行端一侧；3–4号在南宅砖门与外梯对应位置。"
  },
  "limits": "城图旧标高23.75/23.95m未经实测。西部树冠下及东边对面浅色建筑的原始产权缺少逐户证。照片观察点、院内台阶和绿牌只用于建筑的组别与朝向，不作测绘门址。",
  "photo_identification": [
    "街道望南的弄口照片与返回向北的照片以夹道两边红砖住宅/浅色建筑相对校验，北宅和南宅都在弄堂西侧。",
    "1、2两门号同见于北宅图。南宅图见砖墙绿3，博物馆图片另见楼梯侧4。"
  ],
