  "identity": {
    "old_main": "1924年诺曼底公寓，原有武康大楼主楼模型。",
    "east_annex": "1930年新武康大楼，陈保平称东美特公寓，淮海中路1828–1834号。记载五层、约1700平方米；西端与老主楼连接。",
    "rear_outbuilding": "武康路435号汽车库及其改建的住宅，与1930年东侧新楼分开。",
    "modern_door": "2024年5月19日开业报道图1中，绿牌可直接读取“1834 淮海中路”，黑白店牌写“淮海中路1834号-1”。",
    "catalog_note": "市名录门牌指其武康大楼整体条目，未给1930年副楼单列保护编号。"
  },
