  "local_government_record": {
    "archive": "上海市地方志办公室《上海名建筑志》及上海档案信息网《外滩源优秀建筑——光陆大楼》",
    "history": "1925年动工，地方志记1928年2月25日建成，鸿达洋行C.H. Gonda设计。档案网页的“1828年”与其同页1925开工和名建筑志冲突，以1928记载。",
    "program": "戏院在大楼西北部底层及其楼座。楼上为办公室、公寓，区分剧场与全幢用途。名建筑志记九层、下二层和上七层；另一《解放日报》文章用八层口径。",
    "form": "档案记扇形平面，方钢窗下设浮雕图案，四层设勒线、顶层设檐脚，屋顶具塔楼。西向主面和角部门楼细节与2019、2025年实景核对。"
  },
