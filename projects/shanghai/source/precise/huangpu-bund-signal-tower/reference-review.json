{
  "model": "huangpu-bund-signal-tower",
  "public_name": "外滩信号台",
  "listed_name_at_publication": "外滩史陈列室",
  "city_register": {
    "url": "https://fgj.sh.gov.cn/yxlsjz/20210922/8f72fa07617c4828a25ef948cd1c5da7.html",
    "http_status": 200,
    "bytes": 126137,
    "sha256": "47e63758e5a3704166b6fab1a1f499c35936477b67b30fd75dba3acc8885ceac",
    "registered_row": "2A011 外滩信号台 外滩史陈列室 中山东二路"
  },
  "work_catalogue_id": "sh-historic-b2-159",
  "work_catalogue_code": "A-Ⅲ-011",
  "onsite_plaque": {
    "photo_index": 7,
    "address": "中山东二路1号甲",
    "inscription": "原为洋泾浜气象信号台。外滩信号台（初建于1883年，是亚太地区最早的信号台之一）。马第设计，钢筋混凝土结构，1907年建造。圆柱型塔高50米，顶部装风向仪。1993年外滩道路拓宽时，信号台整体向东南移位20余米。",
    "declared": "上海市人民政府 1994年2月15日公布"
  },
  "year_variants": {
    "old_mast": "市牌载初建1883年，地方叙述亦记1884年起服务。",
    "present_tower": "现场市牌和2013年修缮报道均载1907年。",
    "height": "市牌以全塔计约50米，英文报道与建筑描述分别列塔身约36.8米和旗杆后的总高近50米。交付比例按实照估算。"
  },
  "relocation": "1993年向东南移动20余米。继承现存建筑足迹。早期木杆海事信号台以及原塔位置仅作史料记录。",
  "sources": {
    "report_2013": {
      "url": "https://www.chinanews.com.cn/cul/2013/08-08/5140259.shtml",
      "status": 200,
      "sha256": "b872ebdc9a6ac2fb0a67e25d0915f11acf8944d250cbd4d9ef9dcc947cd542dc",
      "title": "外滩天文台正在修缮 将重挂气象标志",
      "publisher": "中国新闻网",
      "date": "2013-08-08"
    },
    "historical_summary": {
      "url": "https://zh.wikipedia.org/wiki/%E5%A4%96%E6%BB%A9%E4%BF%A1%E5%8F%B7%E5%8F%B0",
      "sha256": "280958800618f49f0482e805598a6d1f39fe6783e1d635c9c27392688b228c2b",
      "text": "1993年10月，在外滩综合改造工程中，天文台正处于规划后中山东一路中央，为了保护这座历史建筑，政府决定将它平移。当时还没有成熟的老建筑平移技术，天文台一天也只能移动几厘米。最后这个重达450吨的天文台还是成功整体向江边移动了24.5米且没有丝毫损坏，立于现址。"
    }
  },
