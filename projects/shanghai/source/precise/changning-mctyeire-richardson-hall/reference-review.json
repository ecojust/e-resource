  "history": {
    "school_history": {
      "url": "https://www.thepaper.cn/newsDetail_forward_1494412",
      "sha256": "999a09e0dbeb7d03e530229eae3bc476b2375300822d53b30c266ee66d671d92",
      "publication": "澎湃新闻、2016年校史出版访谈",
      "observations": [
        "1892年汉口路创办，1917年迁址，1952年中西女中和圣玛丽女中合组市三女中。1917年迁校没有单独确定东楼建筑年代。"
      ]
    },
    "conservation": "1994年2月15日列市级优秀历史建筑，2014年4月4日为市级文物保护单位。",
    "scope": "1952年原中西女中及圣玛利亚女中合组。景莲堂是北楼，五一楼是东楼。",
    "east_hall": "1916年购入原有住宅并有学生先行使用。1922年9月12日寄宿部进入新宿舍Lambuth-Clopton Hall。Bond于2018年明确将此楼对应今五一堂，文旅推广网称东楼海涵堂。1935年建景莲堂。"
  },
  "scale": "原城市独立户733与w494669990近重合，草坪正立面长边约58.78米。2019及2025年长屋面连两端分别58.09与59.50米，前红瓦段43.16与42.51米。立面外法线142.4度。",
  "limits": "两期航片约束北楼倒T形平面。门厅与门扇按4.65米后门总宽配准。上部东西廊、礼堂内部跨度、楼座高度、座位排数和舞台深度为条件尺寸；侧门另设原点，精确接点待图。外部定年与东楼异文见正文。",
