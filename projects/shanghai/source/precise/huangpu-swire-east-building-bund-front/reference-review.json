{
  "id": "huangpu-swire-east-building-bund-front",
  "formal_name": "太古洋行东楼临江七开间红砖正立面",
  "official_code": "4A025",
  "listed_address": "黄浦区中山东二路22号",
  "former": "英商太古洋行",
  "listed_current": "丰华大楼／上海工业发展基金会",
  "river_front": "原城747东北边，从南端至北端约30.76米。中轴主门、二层曲山花、三层长方窗、四五层中心窄双券和弧顶山花可核。",
  "historical_change": "2011年5月未封堵的开间可见后退廊壁。2015年公布的街照及2022年10月竣工照可见连续窗框、玻璃及铁栏。模型按后期可见状况绘制。",
  "excluded": [
    "新永安路沿街北楼",
    "南楼",
    "东楼其余三面",
    "室内与中庭透光顶、壁画",
