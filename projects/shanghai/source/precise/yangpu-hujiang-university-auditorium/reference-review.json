  "primary_identity": {
    "official_1994": "2G002 沪江大学，军工路516号礼堂/实验楼。",
    "documented_scope": "1937年东西向University Auditorium主礼堂。北侧联体White Chapel仅记录与主厅确认的交接，不将其余北翼或整个校园并入此次交付。",
    "2005_separate": "4G005含中学礼堂及科学馆等多项。校档案馆单栋说明把科学馆市保公布日期列为2005-10-31，现作格致堂。暂保留1994目录“实验楼”归属，需第二批原保护平面或学校逐栋身份案。"
  },
  "chronology": [
    {
      "date": "1936",
      "fact": "校档案馆记1936年募建、举行破土礼，内文列9月。"
    },
    {
      "date": "1937-05",
      "fact": "大学大礼堂暨北侧思魏堂落成。校档案馆记建筑面积2030平方米、二层砖混结构。"
    },
    {
      "date": "1949-02",
      "fact": "校董事会常务委员会将大学大礼堂亦命名为思魏堂。此后名称覆盖整组，“思魏堂今貌”图题不单独指北翼。"
    },
    {
      "date": "1956-09-23 / 1957",
      "fact": "龙卷风造成重损，次年完成修缮，校档保存受灾照片。设计效果图上的高钟塔与档案馆公布的竣工历史照、今貌照片不同。"
    }
  ],
