#!/usr/bin/env bash
set -eu
# Each device still opens a separate system Chromium on the actual site.
# Use the software GL renderer on the ordinary X server already used for 262.
export DISPLAY=:53
export LIBGL_ALWAYS_SOFTWARE=1
export LP_NUM_THREADS=1
export GALLIUM_DRIVER=llvmpipe
export MESA_SHADER_CACHE_DISABLE=true
a=()
for arg in "$@"; do
 case "$arg" in
  --headless|--headless=*|--use-angle=*|--ozone-platform=*|--use-gl=*|--hide-scrollbars) ;;
  *) a+=("$arg") ;;
 esac
done
exec taskset -c "$(awk '/Cpus_allowed_list/{split($2,a,/[,-]/);print a[1]}' /proc/self/status)" /usr/bin/chromium "${a[@]}" --ozone-platform=x11 --use-gl=angle --use-angle=gl --ignore-gpu-blocklist --disable-gpu-watchdog --enable-low-end-device-mode --disable-background-networking --disable-sync --disable-gpu-program-cache --disable-gpu-rasterization --disk-cache-size=1048576 --force-gpu-mem-available-mb=64 '--js-flags=--optimize-for-size --max-old-space-size=160 --max-semi-space-size=1'
