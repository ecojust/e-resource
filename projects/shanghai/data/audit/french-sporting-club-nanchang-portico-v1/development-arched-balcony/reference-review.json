  "model": "huangpu-french-sporting-club-nanchang-portico",
  "title": "法国体育总会南昌路门廊与券窗阳台",
  "address": "南昌路57号",
  "plaque_issued": "2005-10-31",
  "author_note": "官方市牌和市表未列建筑师。2014文章同时出现赉安与万茨，故此处仅依市牌记录建成年份与材料。",
  "building_history": {
    "year_built": 1931,
    "alumnus_article": "https://blog.wenxuecity.com/myblog/21273/201608/1215332.html",
    "author": "思苽",
    "published": "2016-08",
    "statement": "作者1958至1960年在此参加业余训练，2009年回访，记述57号归入科学会堂，后作上海科技发展展示馆。"
  },
  "numbered_images": [
    {
      "index": 7,
      "source_url": "https://s3.sinaimg.cn/mw690/001HIrzOgy6FJzs4AqS12&690",
