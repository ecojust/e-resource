  "observed_refinements_from_preliminary": [
    "普通窗山花上移，处理首轮几何审查发现的压窗问题。",
    "塔顶弧山花专用升高至1.4米，东北冠弧升高至1.7米，最终近景显示其弧形轮廓更明确。",
    "主要视图降低相机以突出街面；近景扩大画幅并提高目标，容纳简化天线顶。"
  ],
  "material_limits": [
    {
      "topic": "弧形入口",
      "limit": "圆角采用五段平面近似，阳台随之分段；实物连续曲率和精确半径未校准。"
    },
    {
      "topic": "街面窗格与柱式",
      "limit": "窗口及开间规整重复；巨壁柱分组、花饰柱头、爱奥尼克双柱、山花和檐下托座比照片明显简化。"
    },
    {
      "topic": "铁栏与灯具",
      "limit": "长廊和塔亭栏杆为简化重复构件，非实测铸铁花饰或灯具复制。"
    },
    {
      "topic": "塔楼与天线",
      "limit": "北立面中西段位置由照片引导，精确坐标仍为估计。现代照片有天线，但没有高度和安装年代证据，54米杆顶不是已核历史总高。"
    },
    {
      "topic": "背面与屋面",
      "limit": "后立面、天井、屋顶花园及设备未有完整照片核验，当前规则墙面和封闭屋顶为估计补全。"
    },
    {
      "topic": "尺度",
      "limit": "66×94米主体、12.4米圆角、30米主屋面、34.4米局部七层屋面、45.8米塔帽及54米天线顶均为作者估计。文献只支持6层局部7层等概略描述，不能从视觉相似反推实测。"
    },
    {
      "topic": "时期与外观材质",
      "limit": "核心图拍于2011、2013和2025年；夜景金色照明不代表白天材料颜色。模型省略商业招牌、广告、节庆布置和风化，摄影棚光照不是现场照明研究。"
    }
  ],
